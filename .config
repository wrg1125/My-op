# OpenWrt 官方固件配置 - x86/64 (N100 + Intel I226-V)
# 使用 openwrt/openwrt 官方源码 + make defconfig 自动补全

CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_Generic=y

# 1G rootfs (ext4)
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_ROOTFS_PARTSIZE=1024

# LuCI + 中文（全模块：LUCI_LANG_zh_Hans 自动依赖所有插件的中文翻译包）
# 25.12 源码语言目录为 zh_Hans，生成的包名经 LC alias 映射为 zh-cn
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl-openssl=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# 网卡驱动: I226-V (igc) + 虚拟机 virtio
CONFIG_PACKAGE_kmod-igc=y
CONFIG_PACKAGE_kmod-virtio-net=y

# immortalwrt 插件
CONFIG_PACKAGE_luci-app-vlmcsd=y
CONFIG_PACKAGE_vlmcsd=y
CONFIG_PACKAGE_luci-theme-argon=y

# dae/daed (eBPF 代理) 依赖的内核模块
CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-netlink-diag=y

# 固件格式: combined (squashfs+ext4)
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_TARGET_x86_64_Generic_combined-squashfs=y
CONFIG_TARGET_x86_64_Generic_combined-ext4=y
